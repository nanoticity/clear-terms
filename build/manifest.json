{
  "manifest_version": 3,
  "name": "Clear Terms",
  "version": "0.1.0",
  "description": "Analyze Terms of Service for problematic clauses",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [{
    "resources": ["model/model.json"],
    "matches": ["<all_urls>"]
  }]
}
