{
  "manifest_version": 3,
  "name": "Clear Terms",
  "version": "0.4.0",
  "description": "Analyzes Terms of Service and Privacy Policy pages",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.openai.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [{
    "resources": ["model/model.json"],
    "matches": ["<all_urls>"]
  }]
}
